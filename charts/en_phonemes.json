{
  "delimiters": {
    ".":  {"ipa": ".", "name": "Syllable break", "desc": "Separates phonological beats"},
    "|":  {"ipa": "|", "name": "Minor group",    "desc": "Short pause / foot boundary"},
    "||": {"ipa": "‖", "name": "Major group", "desc": "Full stop / intonational break"}
  },
  "modifiers": {
    ":":  {"ipa": "ː", "name": "Length mark",     "desc": "Triangular colon for long vowels"},
    "'":  {"ipa": "ˈ", "name": "Primary stress",  "desc": "Raised vertical line before syllable"},
    ",":  {"ipa": "ˌ", "name": "Secondary stress", "desc": "Lowered vertical line before syllable"},
    "~":  {"ipa": "̃", "name": "Tilde",           "desc": "Combining diacritic for nasalization"}
  },
  "monophthongs": {
    "short_vowels": [
      {"code": "I",  "ipa": "ɪ", "pos": "High-mid, Front",       "ex": "bit"},
      {"code": "e",  "ipa": "e",      "pos": "Mid, Front",             "ex": "bet"},
      {"code": "ae", "ipa": "æ", "pos": "Low, Front",             "ex": "bat"},
      {"code": "^ ",  "ipa": "ʌ", "pos": "Low-mid, Back-central",  "ex": "but"},
      {"code": "ah",  "ipa": "ɒ", "pos": "Low, Back",              "ex": "pot"},
      {"code": "oo",  "ipa": "ʊ", "pos": "High-mid, Back",         "ex": "book"},
      {"code": "uh", "ipa": "ə", "pos": "Mid, Central",           "ex": "about"}
    ],
    "long_vowels": [
      {"code": "i", "ipa": "i", "pos": "High, Front",      "ex": "beat"},
      {"code": "er", "ipa": "ɜː", "pos": "Mid, Central", "ex": "bird"},
      {"code": "aa", "ipa": "ɑː", "pos": "Low, Back",    "ex": "car"},
      {"code": "ou", "ipa": "ɔː", "pos": "Mid-low, Back","ex": "bought"},
      {"code": "u", "ipa": "u",  "pos": "High, Back",      "ex": "boot"}
    ]
  },
  "diphthongs": [
    {"code": "eI", "ipa": "eɪ", "ex": "bait"},
    {"code": "aI", "ipa": "aɪ", "ex": "bite"},
    {"code": "oy", "ipa": "ɔɪ", "ex": "boy"},
    {"code": "ow", "ipa": "aʊ", "ex": "bout"},
    {"code": "oa", "ipa": "əʊ", "ex": "boat"},
    {"code": "ia", "ipa": "ɪə", "ex": "here"},
    {"code": "ea", "ipa": "eə", "ex": "hair"},
    {"code": "ua", "ipa": "ʊə", "ex": "tour"}
  ],
  "consonants": {
    "plosives": [
      {"code": "p", "ipa": "p", "articulation": "Bilabial"}, 
      {"code": "b", "ipa": "b", "articulation": "Bilabial"},
      {"code": "t", "ipa": "t", "articulation": "Alveolar"}, 
      {"code": "d", "ipa": "d", "articulation": "Alveolar"},
      {"code": "k", "ipa": "k", "articulation": "Velar"}, 
      {"code": "g", "ipa": "g", "articulation": "Velar"}
    ],
    "fricatives": [
      {"code": "f",  "ipa": "f", "articulation": "Labio-dental"}, 
      {"code": "v",  "ipa": "v", "articulation": "Labio-dental"},
      {"code": "th", "ipa": "θ", "articulation": "Dental", "ex": "thin"},
      {"code": "dh", "ipa": "ð", "articulation": "Dental", "ex": "that"},
      {"code": "s",  "ipa": "s", "articulation": "Alveolar"}, 
      {"code": "z",  "ipa": "z", "articulation": "Alveolar"},
      {"code": "sh", "ipa": "ʃ", "articulation": "Post-alveolar", "ex": "ship"},
      {"code": "zh", "ipa": "ʒ", "articulation": "Post-alveolar", "ex": "measure"},
      {"code": "h",  "ipa": "h", "articulation": "Glottal"}
    ],
    "affricates": [
      {"code": "ch", "ipa": "tʃ", "articulation": "Post-alveolar"},
      {"code": "jh", "ipa": "dʒ", "articulation": "Post-alveolar"}
    ],
    "nasals": [
      {"code": "m",  "ipa": "m", "articulation": "Bilabial"}, 
      {"code": "n",  "ipa": "n", "articulation": "Alveolar"},
      {"code": "ng", "ipa": "ŋ", "articulation": "Velar"}
    ],
    "approximants": [
      {"code": "l", "ipa": "l", "articulation": "Alveolar"}, 
      {"code": "r", "ipa": "r", "articulation": "Alveolar"},
      {"code": "j", "ipa": "j", "articulation": "Palatal"}, 
      {"code": "w", "ipa": "w", "articulation": "Labio-velar"}
    ],
    "extra": [
      {"code": "tt", "ipa": "ɾ", "articulation": "Alveolar", "desc": "Alveolar tap/flap"}
    ]
  }
}
